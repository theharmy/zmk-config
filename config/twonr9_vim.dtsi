/*
 * Vim layers, driven by zmk-vim-mode.
 *
 * The host daemon writes a small code into three HID LED indicator bits (Compose, Kana,
 * Scroll Lock -- none of which any OS drives on its own); the module decodes it and
 * activates the matching layer set. Code 0 (implicit) turns every managed layer off.
 *
 * normal and visual carry the commands; insert and cmdline stay transparent, so
 * typing there is the base layout untouched.
 *
 * They sit at 7-10, above nav/sym/fn/num/mouse: in normal/visual those layers are
 * deliberately out of reach (hjkl replaces the arrows, the symbol chords replace
 * the sym layer, counts come from the num thumb).
 */
#include <dt-bindings/zmk/hid_usage.h>

/* L_VIM_NORMAL .. L_VIM_CMDLINE live in the keymap with the other layer ids:
 * the combo files are included before this one. */

/ {
    vim_sync {
        compatible = "zmk,hid-indicator-code-listener";
        indicators = <HID_USAGE_LED_COMPOSE HID_USAGE_LED_KANA HID_USAGE_LED_SCROLL_LOCK>;
        managed-layers = <L_VIM_NORMAL L_VIM_VISUAL L_VIM_INSERT L_VIM_CMDLINE>;

        normal        { code = <1>; layers = <L_VIM_NORMAL>; };
        insert        { code = <2>; layers = <L_VIM_INSERT>; };
        visual        { code = <3>; layers = <L_VIM_NORMAL L_VIM_VISUAL>; };
        legacy        { code = <4>; layers = <L_VIM_NORMAL>; bindings = <&kp ESC>; };
        cmdline       { code = <5>; layers = <L_VIM_CMDLINE>; };
        raw           { code = <6>; };
        legacy_silent { code = <7>; layers = <L_VIM_NORMAL>; };
    };
};

/* Bindings run in *position* order, which is what the macro cares about: top row
 * 0-5 (L N D | Y O U), home row 6-13 (S R H T | C E I A), thumbs 14-17. Every key
 * sends the letter the editor reads as a command; DE_Y is the German y (US Z
 * position), so yank really types y on a German layout. */
ZMK_LAYER(vim_normal,
    &kp DE_I    &kp DE_A    &kp DE_O      &kp DE_W    &kp DE_E    &kp DE_B
    &kp DE_D    &kp DE_Y    &kp DE_C      &kp DE_V      &kp DE_H    &kp DE_J    &kp DE_K    &kp DE_L
    &mt LSHFT ESC   &mt LCTRL DE_COLON   &lt L_VIM_OPS DE_FSLH   &lt L_NUM DE_DOT
)

/* Visual is normal with i/a/o replaced: they do nothing while selecting, and
 * indent/toggle-case are what the same fingers reach for. */
ZMK_LAYER(vim_visual,
    &kp DE_LT   &kp DE_GT   &kp DE_TILDE  &kp DE_W    &kp DE_E    &kp DE_B
    &kp DE_D    &kp DE_Y    &kp DE_C      &kp DE_V      &kp DE_H    &kp DE_J    &kp DE_K    &kp DE_L
    &mt LSHFT ESC   &mt LCTRL DE_COLON   &lt L_VIM_OPS DE_FSLH   &lt L_NUM DE_DOT
)

ZMK_LAYER(vim_insert,
    &trans &trans &trans
    &trans &trans &trans &trans
    &trans &trans &trans
    &trans &trans &trans &trans
    &trans &trans &trans &trans
)

ZMK_LAYER(vim_cmdline,
    &trans &trans &trans
    &trans &trans &trans &trans
    &trans &trans &trans
    &trans &trans &trans &trans
    &trans &trans &trans &trans
)

/* Held on the right-inner thumb: the commands the alphabet has no room for.
 * Position order again -- top row 0-5, home row 6-13.
 *
 * yy/cc/gg are not here: pressing the letter twice is the same gesture vim asks
 * for, and the slots are better spent on what cannot be typed otherwise. dd is
 * the exception -- deleting a line is the one double done constantly. redo is
 * LC(R) because no vim key reaches it. Uppercase comes from the Shift thumb, %
 * and the brackets from num and the chords. */
ZMK_MACRO(vim_dd, bindings = <&kp DE_D &kp DE_D>; wait-ms = <0>; tap-ms = <5>;)

ZMK_LAYER(vim_ops,
    &kp DE_N0   &kp DE_DOLLAR &kp DE_ASTRK  &kp DE_N    &kp DE_F    &kp DE_T
    &kp DE_U    &kp DE_P      &kp DE_X      &kp DE_G       &kp DE_CARET &kp LC(R)  &vim_dd    &kp DE_R
    &trans      &trans        &trans        &trans
)
