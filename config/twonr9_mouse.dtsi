/*
 * Mouse layer (L_MOUSE 6): pointer movement, mouse buttons and scrolling.
 *
 * Entered by tapping Space + Num together (positions 16 + 17). The auto-layer
 * keeps the layer up while it is used and typing any other key leaves it:
 * moving, scrolling and clicking raise no keycodes, so only a real key exits.
 * This file is included last in twonr9.keymap: a ZMK layer's index is its
 * order among the keymap's layer nodes, so it must come after all the others.
 */

#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        auto_mouse: auto_mouse {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            // Mouse buttons raise no keycodes today, so this list is documentation
            // as much as anything; typing a key is what actually leaves the layer.
            continue-list = <MB1 MB2 MB3 MB4 MB5>;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_mouse: combo_mouse {
            timeout-ms = <COMBO_TERM>;
            key-positions = <16 17>;
            layers = <L_A1 L_A2 L_NAV L_SYM L_FN L_NUM>;
            bindings = <&auto_mouse L_MOUSE>;
        };
        // Nothing on the mouse layer raises a keycode (buttons, movement and scrolling
        // send no keys; the mods are ignored), so it needs a way out of its own: both
        // left thumbs, which send Escape and end the auto-layer.
        combo_mouse_exit: combo_mouse_exit {
            timeout-ms = <COMBO_TERM>;
            key-positions = <14 15>;
            layers = <L_MOUSE>;
            bindings = <&kp ESC>;
        };
    };
};

ZMK_LAYER(mouse,
//              ╭───────────┬───────────┬───────────╮      ╭───────────┬───────────┬───────────╮
                  &mkp MB3    &mkp MB2    &mkp MB1           &msc SCRL_UP &msc SCRL_DOWN &mkp MB4
//       ╭──────┼───────────┼───────────┼───────────┤      ├───────────┼───────────┼───────────┼───────────╮
          &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
//       ╰──────┴───────────┴───────────┴───────────╯      ╰───────────┴───────────┴───────────┴───────────╯
                         &msc SCRL_LEFT  &msc SCRL_RIGHT         &mkp MB1      &mkp MB5
//                        ╰───────────┴───────────╯      ╰───────────┴───────────╯
)
