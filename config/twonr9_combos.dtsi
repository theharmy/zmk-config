/*
 * ==============================================================================
 * TwoNr9 Combo Definitions (Modular Include)
 * ==============================================================================
 *
 * Categorized by functionality:
 * 1. Vertical German Digraph Bigrams (Layer 0 & Layer 1)
 * 2. Coding & Navigation Combos (Tab, Enter, Esc, Backspace, Delete)
 * 3. Fast Programming Symbols (Under, Minus, Colon, Semi)
 * 4. System Chords (Caps Word, Studio Unlock with 200ms idle)
 * ==============================================================================
 */

#pragma once

// --- Top Row Utilities (Every Layer) ---
// EVERY_LAYER rather than no layer list at all, so the two-key ones can carry the
// idle guard: rolling two top-row letters types them instead of firing a utility.
ZMK_COMBO(combo_tab,      &kp TAB,       0 1,   EVERY_LAYER, COMBO_TERM, CHORD_IDLE_MS)  // Left Top (0+1): Tab
ZMK_COMBO(combo_rtn,      &kp RETURN,    1 2,   EVERY_LAYER, COMBO_TERM, CHORD_IDLE_MS)  // Left Top (1+2): Enter
ZMK_COMBO(combo_bspc,     &bs_del,       3 4,   EVERY_LAYER, COMBO_TERM, CHORD_IDLE_MS)  // Right Top (3+4): Morphing Backspace / Delete
ZMK_COMBO(combo_cbspc,    &kp LC(BSPC),  4 5,   EVERY_LAYER, COMBO_TERM, CHORD_IDLE_MS)  // Right Top (4+5): Word Delete Backwards
ZMK_COMBO(combo_esc,      &kp ESC,       3 4 5, EVERY_LAYER)                             // Right Top (3+4+5): Instant Esc (3 keys: no guard)

/* German Eszett: variant-specific -- bugwind on S+Space (symbol_work.dtsi),
 * srht on S+R (twonr9_combos_srht.dtsi). Was shared at Left Home (6+7). */

// --- Home Row Programming Symbols ---
// ALL_BUT_MOUSE is every layer but mouse: in vim normal/visual these are the
// only way to type a symbol (the sym layer's home-row hold is a motion there),
// which is what ci(, da", f, and r; need. CHORD_IDLE_MS keeps a fast roll of
// two motions (ci, di, jk) typing instead of firing one.
ZMK_COMBO(combo_under,    &kp DE_UNDER,  7 9,   ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)  // Left Home (7+9): snake_case Underscore
ZMK_COMBO(combo_minus,    &kp DE_MINUS,  7 8,   ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)  // Left Home (7+8): Hyphen / Minus
ZMK_COMBO(combo_colon,    &kp DE_COLON,  11 12, ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)  // Right Home (11+12): Colon :
ZMK_COMBO(combo_semi,     &kp DE_SEMI,   10 12, ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)  // Right Home (10+12): Statement Semicolon ;

// --- Universal Utilities ---
ZMK_COMBO(combo_a2_shift, &macro_a2_shift, 14 15)                       // Left Thumbs (14+15): Sticky Layer A2 + Sticky Left Shift
ZMK_COMBO(combo_stdio,    &studio_unlock, 6 7 8 9, L_SYM, 50, 200)         // Left Home 3-key (7+8+9): Studio Unlock
// Magic shift, like the symbols: everywhere but mouse, and guarded so that a fast
// roll of two motions (c+v, h+j in vim normal) types them instead of shifting.
ZMK_COMBO(combo_shiftl,  MAGIC_SHIFT, 8 9,   ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)
ZMK_COMBO(combo_shiftr,  MAGIC_SHIFT, 10 11, ALL_BUT_MOUSE, COMBO_TERM, CHORD_IDLE_MS)


// --- Layer 5: Numpad Numbers ---
ZMK_COMBO(combo_7,        &kp DE_N7,     3 10,  L_NUM)                   // Right Col 1 (3+10): 7
ZMK_COMBO(combo_8,        &kp DE_N8,     4 11,  L_NUM)                   // Right Col 2 (4+11): 8
ZMK_COMBO(combo_9,        &kp DE_N9,     5 12,  L_NUM)                   // Right Col 3 (5+12): 9

/* --- Layer FN: Bluetooth connections
ZMK_COMBO(combo_btprev,      &bt BT_PRV,  0 1,   L_FN)                    //bt 1 FN top left two keys
ZMK_COMBO(combo_btnext,      &bt BT_NXT,  1 2,   L_FN)                    //bt 2 FN left top right two keys
ZMK_COMBO(combo_btclr,      &bt BT_CLR,  0 2,   L_FN)                    //bt 3 FN left key 1 & 3
*/


/* Sym layer is now only entered via the R-Out thumb (SYM_DUAL): every
 * sym-layer symbol has an alpha-layer diagonal chord (see symbol_work.dtsi),
 * so the home-row triads were removed to free their keys from combo
 * conflicts. */

